# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://coob-optique.bf
# Adresses exactes des agences (affichées sur le site et dans les données structurées)
NEXT_PUBLIC_ADDRESS_KOULOUBA="Koulouba, Ouagadougou"
NEXT_PUBLIC_ADDRESS_GOUNGHIN="Gounghin, Ouagadougou"
NEXT_PUBLIC_ADDRESS_BOBO="Bobo-Dioulasso"
# Liens Google Maps (itinéraire) de chaque agence, et lien vers les avis de l'agence principale
# NEXT_PUBLIC_MAPS_KOULOUBA=
# NEXT_PUBLIC_MAPS_GOUNGHIN=
# NEXT_PUBLIC_MAPS_BOBO=
# NEXT_PUBLIC_REVIEWS_URL=
# Numéro WhatsApp sans le +
NEXT_PUBLIC_WHATSAPP_NUMBER=22678393815
# Réseaux sociaux (affichés dans le pied de page si renseignés)
# NEXT_PUBLIC_FACEBOOK_URL=
# NEXT_PUBLIC_INSTAGRAM_URL=

# ---- Espace équipe (/admin) ----
# Obligatoire pour activer l'espace équipe.
ADMIN_PASSWORD=changez-moi
# Facultatif : secret distinct pour signer les sessions (sinon ADMIN_PASSWORD est utilisé)
# ADMIN_SESSION_SECRET=

# ---- Base de données ----
# Sans DATABASE_URL : stockage JSON local dans ./data/store.json (dev / petit serveur).
# Avec DATABASE_URL ou POSTGRES_URL (Neon via Vercel Storage, Supabase…) : tables créées automatiquement.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DATA_FILE=data/store.json

# ---- SMS ----
# console (défaut, affiche dans les logs) | twilio | orange
SMS_PROVIDER=console

# Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1XXXXXXXXXX
# ou TWILIO_MESSAGING_SERVICE_SID=

# Orange SMS API (developer.orange.com — Burkina Faso)
# ORANGE_CLIENT_ID=
# ORANGE_CLIENT_SECRET=
# ORANGE_SENDER=+2260000
# ORANGE_SENDER_NAME=OptiqueCOOB

# ---- Rappels de rendez-vous (cron quotidien, voir vercel.json) ----
CRON_SECRET=changez-moi-aussi

# ---- Essayage virtuel ----
# Par défaut, les fichiers MediaPipe sont servis depuis /public/mediapipe (auto-hébergés).
# Pour utiliser un CDN à la place :
# NEXT_PUBLIC_MEDIAPIPE_WASM_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@1.0.1/wasm
# NEXT_PUBLIC_FACE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task
