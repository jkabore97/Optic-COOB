{
  "name": "optique-coob",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "frames": "node scripts/generate-frames.mts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "postinstall": "node scripts/setup-mediapipe.mjs",
    "build:cf": "NEXT_IMAGE_UNOPTIMIZED=1 opennextjs-cloudflare build",
    "preview:cf": "NEXT_IMAGE_UNOPTIMIZED=1 opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "NEXT_IMAGE_UNOPTIMIZED=1 opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.4",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "three": "^0.185.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.1"
  }
}
